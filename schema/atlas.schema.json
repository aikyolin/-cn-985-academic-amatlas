{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academic Atlas canonical snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "campuses",
    "org_units",
    "people",
    "institutions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "org_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "parent_id",
          "campus_ids",
          "source_url",
          "school_id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "campus_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "school_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "person_id",
          "name",
          "department_id",
          "campus_ids",
          "education",
          "mentors",
          "publications",
          "sources",
          "unknowns",
          "school_id"
        ],
        "properties": {
          "person_id": {
            "type": "string"
          },
          "education": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "degree",
                "institution",
                "source_url",
                "institution_985",
                "region",
                "continent_code",
                "event_kind",
                "degree_awarded"
              ],
              "properties": {
                "institution_985": {
                  "enum": [
                    "yes",
                    "no",
                    "unknown"
                  ]
                },
                "region": {
                  "enum": [
                    "mainland",
                    "hmt",
                    "overseas",
                    "unknown"
                  ]
                },
                "event_kind": {
                  "type": "string"
                },
                "degree_awarded": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "mentors": {
            "type": "array"
          },
          "committee_members": {
            "type": "array"
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "school_id": {
            "type": "string",
            "minLength": 1
          },
          "campus_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "professional_research_advisors": {
            "type": "array",
            "description": "已直接核实的职业科研指导，独立于普通合作及学位师承，不借用空教育事件。",
            "items": {
              "type": "object",
              "required": [
                "name",
                "relationship_kind",
                "relationship_status",
                "education_event_id",
                "include_in_mentorship_graph",
                "include_in_degree_mentorship_graph",
                "include_in_verified_mentor_count",
                "include_in_verified_professional_guidance_count",
                "source_url"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "relationship_kind": {
                  "const": "professional_research_advisor"
                },
                "relationship_status": {
                  "const": "verified_direct_statement"
                },
                "education_event_id": {
                  "type": "null"
                },
                "appointment_event_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "person_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "include_in_mentorship_graph": {
                  "const": false
                },
                "include_in_degree_mentorship_graph": {
                  "const": false
                },
                "include_in_verified_mentor_count": {
                  "const": false
                },
                "include_in_verified_professional_guidance_count": {
                  "const": true
                },
                "source_url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                "profile_source_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },
                "source_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "profile_source_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "navigation_verified": {
                  "type": "boolean"
                },
                "quick_link_eligible": {
                  "type": "boolean"
                },
                "start": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "end": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "pending_people": {
      "type": "array",
      "description": "身份或正文资料待完善，不计详细档案、学历筛选或确证成果统计",
      "items": {
        "type": "object",
        "required": [
          "person_id",
          "name",
          "profile_status",
          "roster_entry_id",
          "school_id",
          "campus_ids"
        ],
        "properties": {
          "profile_status": {
            "enum": [
              "roster_identity_pending",
              "profile_details_pending"
            ]
          },
          "education": {
            "type": "array",
            "maxItems": 0
          },
          "mentors": {
            "type": "array",
            "maxItems": 0
          },
          "publications": {
            "type": "array",
            "maxItems": 0
          },
          "school_id": {
            "type": "string",
            "minLength": 1
          },
          "campus_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "professional_research_advisors": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    "institutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "official_name",
          "official_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "official_name": {
            "type": "string",
            "minLength": 1
          },
          "official_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "campuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "school_id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "school_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
